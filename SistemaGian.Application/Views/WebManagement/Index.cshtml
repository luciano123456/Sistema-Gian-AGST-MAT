                <strong data-current-page>Inicio</strong>
            </div>
            <small>Usá la barra de navegación de la vista previa para cambiar de página o editar sus nombres.</small>
        </div>

        <div class="edit-tools">
            <label class="tool-color" title="Color principal">
                <input asp-for="PrimaryColor" form="settingsForm" type="color" />
                <span>Principal</span>
            </label>
            <label class="tool-color" title="Color de acción">
                <input asp-for="AccentColor" form="settingsForm" type="color" />
                <span>Acción</span>
            </label>
            <label class="tool-text" title="WhatsApp comercial">
                <i class="fa fa-whatsapp"></i>
                <input asp-for="WhatsAppNumber" form="settingsForm" placeholder="54911..." />
            </label>
            <div class="tool-device" role="group" aria-label="Ancho de la vista">
                <button type="button" class="active" data-preview-width="desktop" title="Escritorio"><i class="fa fa-desktop"></i></button>
                <button type="button" data-preview-width="mobile" title="Celular"><i class="fa fa-mobile"></i></button>
            </div>
            <span class="edit-dirty" data-dirty hidden><i class="fa fa-circle"></i>Cambios sin guardar</span>
            <button class="web-save" type="submit" form="settingsForm"><i class="fa fa-save"></i>Guardar</button>
        </div>
    </div>

    @* ------------------------------ INICIO ------------------------------ *@
    <div class="web-tab-pane active" id="web-tab-home">
        <div class="site-canvas" data-preview>
            <div class="site-topbar">
                <span class="live" contenteditable="true" data-edit-field="TopbarPrimary" data-single-line="true">@Model.TopbarPrimary</span>
                <span class="live" contenteditable="true" data-edit-field="TopbarSecondary" data-single-line="true">@Model.TopbarSecondary</span>
            </div>
            <div class="site-header">
                <img src="~/Imagenes/logo-color.png" alt="Logo" />
                <div class="site-header-search"><i class="fa fa-search"></i><span class="live" contenteditable="true" data-edit-field="SearchPlaceholder" data-single-line="true">@Model.SearchPlaceholder</span><span class="live" contenteditable="true" data-edit-field="SearchButton" data-single-line="true">@Model.SearchButton</span></div>
                <div class="site-nav">
                    <span class="site-nav-item"><button type="button" class="is-current" data-web-tab="home"><span class="live nav-label" contenteditable="true" data-edit-field="NavHomeLabel" data-single-line="true" data-placeholder="Inicio">@Model.NavHomeLabel</span></button><button type="button" class="live-pencil nav-pencil" data-edit-nav="NavHomeLabel" title="Editar Inicio"><i class="fa fa-pencil"></i></button></span>
                    <span class="site-nav-item"><button type="button" data-web-tab="catalog"><span class="live nav-label" contenteditable="true" data-edit-field="NavCatalogLabel" data-single-line="true" data-placeholder="Catálogo">@Model.NavCatalogLabel</span></button><button type="button" class="live-pencil nav-pencil" data-edit-nav="NavCatalogLabel" title="Editar Catálogo"><i class="fa fa-pencil"></i></button></span>
                    <span class="site-nav-item"><button type="button" data-web-tab="about"><span class="live nav-label" contenteditable="true" data-edit-field="NavAboutLabel" data-single-line="true" data-placeholder="Nosotros">@Model.NavAboutLabel</span></button><button type="button" class="live-pencil nav-pencil" data-edit-nav="NavAboutLabel" title="Editar Nosotros"><i class="fa fa-pencil"></i></button></span>
                    <span class="site-nav-item"><button type="button" data-web-tab="contact"><span class="live nav-label" contenteditable="true" data-edit-field="NavQuoteLabel" data-single-line="true" data-placeholder="Presupuesto">@Model.NavQuoteLabel</span></button><button type="button" class="live-pencil nav-pencil" data-edit-nav="NavQuoteLabel" title="Editar Presupuesto"><i class="fa fa-pencil"></i></button></span>
                    <button type="button" class="site-cart" data-web-tab="cart"><span class="live" contenteditable="true" data-edit-field="CartLabel" data-single-line="true">@Model.CartLabel</span> (0)</button>
                </div>
            </div>

            <div class="site-hero" style="background-image:linear-gradient(90deg,rgba(12,28,45,.82),rgba(12,28,45,.28)),url('@Model.HeroImageUrl');background-size:cover;background-position:center;">
                <img class="site-hero-mark" src="~/Imagenes/logo-color.png" alt="" aria-hidden="true" />
                <div class="site-hero-grid">
                    <div>
                        <div class="live-wrap is-inline">
                            <span class="site-pill live" contenteditable="true" data-edit-field="HeroPill" data-single-line="true" data-placeholder="Bajada corta">@Model.HeroPill</span>
                            <button type="button" class="live-pencil" title="Editar la píldora"><i class="fa fa-pencil"></i></button>
                        </div>
                        <div class="live-wrap">
                            <h1 class="live" contenteditable="true" data-edit-field="HeroTitle" data-single-line="true" data-placeholder="Título principal de la portada">@Model.HeroTitle</h1>
                            <button type="button" class="live-pencil" title="Editar el título"><i class="fa fa-pencil"></i></button>
                        </div>
                        <div class="live-wrap">
                            <p class="live" contenteditable="true" data-edit-field="HeroText" data-placeholder="Texto de bienvenida">@Model.HeroText</p>
                            <button type="button" class="live-pencil" title="Editar el texto"><i class="fa fa-pencil"></i></button>
                        </div>
                        <div class="site-hero-search">
                            <i class="fa fa-search"></i>
                            <span class="live" contenteditable="true" data-edit-field="HomeSearchPlaceholder" data-single-line="true">@Model.HomeSearchPlaceholder</span>
                            <span class="site-hero-search-btn live" contenteditable="true" data-edit-field="HomeSearchButton" data-single-line="true">@Model.HomeSearchButton</span>
                        </div>
                        <div class="site-chips"><strong class="live" contenteditable="true" data-edit-field="HomeChipsLabel" data-single-line="true">@Model.HomeChipsLabel</strong><span>Cemento</span><span>Hierro</span><span>Ladrillos</span></div>
                        <div class="site-actions">
                            <button type="button" class="site-btn live" data-web-tab="catalog" contenteditable="true" data-edit-field="HomeHeroCtaCatalog" data-single-line="true">@Model.HomeHeroCtaCatalog</button>
                            <span class="site-btn is-whatsapp live" contenteditable="true" data-edit-field="HomeHeroCtaWhatsApp" data-single-line="true">@Model.HomeHeroCtaWhatsApp</span>
                            <button type="button" class="site-btn is-ghost live" data-web-tab="contact" contenteditable="true" data-edit-field="HomeHeroCtaQuote" data-single-line="true">@Model.HomeHeroCtaQuote</button>
                        </div>
                    </div>

                    <div class="site-card live-wrap">
                        <h3 class="live" contenteditable="true" data-edit-field="AudienceTitle" data-single-line="true" data-placeholder="Título del recuadro">@Model.AudienceTitle</h3>
                        <div class="site-list live" contenteditable="true" data-edit-field="AudienceItems" data-placeholder="Una línea por ítem">@Model.AudienceItems</div>
                        <p class="site-note live" contenteditable="true" data-edit-field="AudienceNote" data-placeholder="Aclaración final">@Model.AudienceNote</p>
                        <button type="button" class="site-audience-link live" data-web-tab="about" contenteditable="true" data-edit-field="HomeAudienceLink" data-single-line="true">@Model.HomeAudienceLink</button>
                        <button type="button" class="live-pencil" title="Editar el recuadro"><i class="fa fa-pencil"></i></button>
                    </div>
                </div>

                <div class="site-hero-metrics">
                    <div>
                        <strong class="live" contenteditable="true" data-edit-field="HomeHighlightOffersTitle" data-single-line="true">@Model.HomeHighlightOffersTitle</strong>
                        <span class="live" contenteditable="true" data-edit-field="HomeHighlightOffersText">@Model.HomeHighlightOffersText</span>
                        <em class="live" contenteditable="true" data-edit-field="HomeHighlightOffersCta" data-single-line="true">@Model.HomeHighlightOffersCta</em>
                    </div>
                    <div>
                        <strong class="live" contenteditable="true" data-edit-field="HomeHighlightCatalogTitle" data-single-line="true">@Model.HomeHighlightCatalogTitle</strong>
                        <span class="live" contenteditable="true" data-edit-field="HomeHighlightCatalogText">@Model.HomeHighlightCatalogText</span>
                        <em>@Model.HomeHeroCtaCatalog</em>
                    </div>
                    <div>
                        <strong class="live" contenteditable="true" data-edit-field="HomeHighlightWhatsAppTitle" data-single-line="true">@Model.HomeHighlightWhatsAppTitle</strong>
                        <span class="live" contenteditable="true" data-edit-field="HomeHighlightWhatsAppText">@Model.HomeHighlightWhatsAppText</span>
                        <em>@Model.HomeHeroCtaWhatsApp</em>
                    </div>
                    <div>
                        <strong class="live" contenteditable="true" data-edit-field="HomeMetricShippingTitle" data-single-line="true">@Model.HomeMetricShippingTitle</strong>
                        <span class="live" contenteditable="true" data-edit-field="HomeMetricShippingText">@Model.HomeMetricShippingText</span>
                        <em>@Model.HomeHeroCtaQuote</em>
                    </div>
                </div>
            </div>

            @{
                var homeHeroEditor = new WebHeroSlideEditorModel
                {
                    Placement = "home",
                    Title = "Fotos de Inicio",
                    Hint = "Estas fotos van atrás del título de la home.",
                    Slides = Model.HomeHeroSlides,
                    FallbackUrl = Model.HeroImageUrl
                };
            }
            <partial name="_HeroSlideEditor" model="homeHeroEditor" />

            <form asp-action="SaveSiteMedia" method="post" enctype="multipart/form-data" class="home-media-editor">
                @Html.AntiForgeryToken()
                <div class="home-media-editor-head">
                    <div>
                        <span class="home-editor-kicker">Imágenes del sitio</span>
                        <h3>Foto de Nosotros</h3>
                        <p>La portada de Inicio y Productos se arma en el carrusel de cada solapa. Acá queda la foto de la historia.</p>
                    </div>
                    <button class="web-save" type="submit"><i class="fa fa-camera"></i>Guardar fotos</button>
                </div>
                <div class="home-media-grid is-single">
                    <label class="home-media-card">
                        <span>Nosotros</span>
                        <img src="@Model.AboutStoryImageUrl" alt="Nosotros" />
                        <input type="file" name="AboutStoryImageFile" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    </label>
                </div>
            </form>

            <div class="site-section home-editor-block" data-section-theme style="background:@Model.HomeBenefitsColor;color:@Model.HomeBenefitsTextColor;">
                <partial name="_SectionTheme" model='("HomeBenefitsColor", Model.HomeBenefitsColor, "HomeBenefitsTextColor", Model.HomeBenefitsTextColor)' />
                <div class="live-wrap">
                    <span class="home-editor-kicker">Beneficios</span>
