                    <div>
                        <strong class="live" contenteditable="true" data-edit-field="FooterCommercialTitle" data-single-line="true">@Model.FooterCommercialTitle</strong>
                        <p class="live" contenteditable="true" data-edit-field="FooterCommercialText">@Model.FooterCommercialText</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ------------------------------ CATALOGO ------------------------------ *@
    <div class="web-tab-pane" id="web-tab-catalog">
        <div class="site-canvas" data-preview>
            <div class="site-topbar"><span class="live" contenteditable="true" data-edit-field="TopbarPrimary" data-single-line="true">@Model.TopbarPrimary</span><span class="live" contenteditable="true" data-edit-field="TopbarSecondary" data-single-line="true">@Model.TopbarSecondary</span></div>
            <div class="site-header">
                <img src="~/Imagenes/logo-color.png" alt="Logo" />
                <div class="site-header-search"><i class="fa fa-search"></i><span class="live" contenteditable="true" data-edit-field="SearchPlaceholder">@Model.SearchPlaceholder</span><span class="live" contenteditable="true" data-edit-field="SearchButton">@Model.SearchButton</span></div>
                <div class="site-nav">
                    <span class="site-nav-item"><button type="button" data-web-tab="home"><span class="live nav-label" contenteditable="true" data-edit-field="NavHomeLabel" data-single-line="true" data-placeholder="Inicio">@Model.NavHomeLabel</span></button><button type="button" class="live-pencil nav-pencil" data-edit-nav="NavHomeLabel" title="Editar Inicio"><i class="fa fa-pencil"></i></button></span>
                    <span class="site-nav-item"><button type="button" class="is-current" data-web-tab="catalog"><span class="live nav-label" contenteditable="true" data-edit-field="NavCatalogLabel" data-single-line="true" data-placeholder="Catálogo">@Model.NavCatalogLabel</span></button><button type="button" class="live-pencil nav-pencil" data-edit-nav="NavCatalogLabel" title="Editar Catálogo"><i class="fa fa-pencil"></i></button></span>
                    <span class="site-nav-item"><button type="button" data-web-tab="about"><span class="live nav-label" contenteditable="true" data-edit-field="NavAboutLabel" data-single-line="true" data-placeholder="Nosotros">@Model.NavAboutLabel</span></button><button type="button" class="live-pencil nav-pencil" data-edit-nav="NavAboutLabel" title="Editar Nosotros"><i class="fa fa-pencil"></i></button></span>
                    <span class="site-nav-item"><button type="button" data-web-tab="contact"><span class="live nav-label" contenteditable="true" data-edit-field="NavQuoteLabel" data-single-line="true">@Model.NavQuoteLabel</span></button><button type="button" class="live-pencil nav-pencil" data-edit-nav="NavQuoteLabel"><i class="fa fa-pencil"></i></button></span>
                    <button type="button" class="site-cart" data-web-tab="cart"><span class="live" contenteditable="true" data-edit-field="CartLabel" data-single-line="true">@Model.CartLabel</span> (0)</button>
                </div>
            </div>

            <section class="catalog-copy-preview">
                <div class="catalog-preview-hero" style="background-image:linear-gradient(90deg,rgba(12,28,45,.82),rgba(12,28,45,.28)),url('@Model.CatalogHeroImageUrl');">
                    <span class="live" contenteditable="true" data-edit-field="CatalogHeroKicker">@Model.CatalogHeroKicker</span>
                    <h1 class="live" contenteditable="true" data-edit-field="CatalogHeroTitle">@Model.CatalogHeroTitle</h1>
                    <p class="live" contenteditable="true" data-edit-field="CatalogHeroText">@Model.CatalogHeroText</p>
                </div>
                @{
                    var catalogHeroEditor = new WebHeroSlideEditorModel
                    {
                        Placement = "catalog",
                        Title = "Fotos de Productos",
                        Hint = "Estas fotos van atrás del título del catálogo.",
                        Slides = Model.CatalogHeroSlides,
                        FallbackUrl = Model.CatalogHeroImageUrl
                    };
                }
                <partial name="_HeroSlideEditor" model="catalogHeroEditor" />
                <div class="catalog-preview-intro" data-section-theme style="background:@Model.CatalogIntroColor;color:@Model.CatalogIntroTextColor;">
                    <partial name="_SectionTheme" model='("CatalogIntroColor", Model.CatalogIntroColor, "CatalogIntroTextColor", Model.CatalogIntroTextColor)' />
                    <div class="theme-copy"><span class="home-editor-kicker live" contenteditable="true" data-edit-field="CatalogIntroKicker">@Model.CatalogIntroKicker</span><h2 class="live" contenteditable="true" data-edit-field="CatalogIntroTitle">@Model.CatalogIntroTitle</h2><p class="live" contenteditable="true" data-edit-field="CatalogIntroText">@Model.CatalogIntroText</p></div>
                    <div class="catalog-trust live" contenteditable="true" data-edit-field="CatalogTrustItems">@Model.CatalogTrustItems</div>
                </div>
                <div class="catalog-filter-preview" data-section-theme style="background:@Model.CatalogFiltersColor;color:@Model.CatalogFiltersTextColor;">
                    <partial name="_SectionTheme" model='("CatalogFiltersColor", Model.CatalogFiltersColor, "CatalogFiltersTextColor", Model.CatalogFiltersTextColor)' />
                    <span class="home-editor-kicker live" contenteditable="true" data-edit-field="CatalogFiltersHead">@Model.CatalogFiltersHead</span>
                    <h3 class="live" contenteditable="true" data-edit-field="CatalogFiltersTitle">@Model.CatalogFiltersTitle</h3>
                    <div class="catalog-filter-fields"><label class="live" contenteditable="true" data-edit-field="CatalogFilterSearch">@Model.CatalogFilterSearch</label><span class="catalog-filter-input live" contenteditable="true" data-edit-field="CatalogFilterSearchPlaceholder">@Model.CatalogFilterSearchPlaceholder</span><label class="live" contenteditable="true" data-edit-field="CatalogFilterCategory">@Model.CatalogFilterCategory</label><span class="catalog-filter-input live" contenteditable="true" data-edit-field="CatalogFilterAllCategories">@Model.CatalogFilterAllCategories</span></div>
                    <div class="catalog-filter-offer"><strong class="live" contenteditable="true" data-edit-field="CatalogFilterOffersTitle">@Model.CatalogFilterOffersTitle</strong><span class="live" contenteditable="true" data-edit-field="CatalogFilterOffersHint">@Model.CatalogFilterOffersHint</span></div>
                    <div class="site-actions"><span class="site-btn live" contenteditable="true" data-edit-field="CatalogFilterSubmit">@Model.CatalogFilterSubmit</span><span class="site-btn is-ghost live" contenteditable="true" data-edit-field="CatalogFilterClear">@Model.CatalogFilterClear</span></div>
                    <p class="live" contenteditable="true" data-edit-field="CatalogFilterHelp">@Model.CatalogFilterHelp</p>
                    <div class="catalog-empty-copy"><span class="live" contenteditable="true" data-edit-field="CatalogEmptyResults">@Model.CatalogEmptyResults</span><span class="live" contenteditable="true" data-edit-field="CatalogSortLabel">@Model.CatalogSortLabel</span></div>
                </div>
            </section>

            <div class="site-section">
                <div class="catalog-workspace-head">
                    <div>
                        <span class="catalog-workspace-kicker"><i class="fa fa-sliders"></i> Administración del catálogo</span>
                        <h2>Productos, banners y categorías</h2>
                        <p>Organizá lo que se muestra en la web. Cada bloque se guarda y publica de forma independiente.</p>
                    </div>
                </div>

                <section class="catalog-editor-section is-banners">
                    <div class="catalog-editor-section-head">
                        <div>
                            <span class="catalog-editor-icon"><i class="fa fa-picture-o"></i></span>
                            <h3>Banners promocionales</h3>
                            <p>Carrusel promocional aparte, con título y botón. No se mezcla con las fotos de portada.</p>
                        </div>
                        <button type="button" class="canvas-action" data-open-banner-modal><i class="fa fa-plus"></i>Crear banner</button>
                    </div>
                    @if (Model.Banners.Any())
                    {
                        <div class="banner-grid">
                            @foreach (var banner in Model.Banners)
                            {
                                <article class="banner-card @(banner.Active ? "" : "is-off")">
                                    <div class="banner-preview">
                                        @if (!string.IsNullOrWhiteSpace(banner.PreviewUrl))
                                        {
                                            <img src="@banner.PreviewUrl" alt="@banner.Title" />
                                        }
                                        else
                                        {
                                            <span>Sin imagen</span>
                                        }
                                    </div>
                                    <div class="banner-body">
                                        <strong>@(string.IsNullOrWhiteSpace(banner.Title) ? "Banner sin título" : banner.Title)</strong>
                                        <div class="catalog-meta">@(banner.Subtitle ?? "Sin subtítulo") · Orden @banner.SortOrder</div>
                                        <div class="banner-flags">
                                            @if (banner.ShowOnHome) { <em>Inicio</em> }
                                            @if (banner.ShowOnCatalog) { <em>Catálogo</em> }
                                            @if (!banner.Active) { <em class="is-warn">Inactivo</em> }
                                        </div>
                                        <div class="catalog-card-actions">
                                            <button type="button" class="web-save"
                                                    data-edit-banner
                                                    data-banner-id="@banner.Id"
                                                    data-banner-title="@banner.Title"
                                                    data-banner-subtitle="@banner.Subtitle"
                                                    data-banner-link="@banner.LinkUrl"
                                                    data-banner-cta="@banner.CtaLabel"
                                                    data-banner-order="@banner.SortOrder"
                                                    data-banner-preview="@banner.PreviewUrl"
                                                    data-banner-active="@banner.Active.ToString().ToLowerInvariant()"
                                                    data-banner-home="@banner.ShowOnHome.ToString().ToLowerInvariant()"
                                                    data-banner-catalog="@banner.ShowOnCatalog.ToString().ToLowerInvariant()">
                                                <i class="fa fa-pencil"></i>Editar
                                            </button>
                                            <form asp-action="DeleteBanner" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bannerId" value="@banner.Id" />
                                                <button class="catalog-delete" type="submit" onclick="return confirm('¿Eliminar este banner?');" title="Eliminar">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <button type="button" class="site-empty site-empty-action" data-open-banner-modal>
                            <i class="fa fa-plus"></i>Creá el primer banner promocional
                        </button>
                    }
                </section>

                <section class="catalog-editor-section is-products">
                    <div class="catalog-editor-section-head">
                        <div>
                            <span class="catalog-editor-icon"><i class="fa fa-cubes"></i></span>
                            <h3>Productos del catálogo <b>@allProducts.Count</b></h3>
                            <p>@visibleProducts.Count visible@(visibleProducts.Count == 1 ? "" : "s") · @publishedCategoryCount categoría@(publishedCategoryCount == 1 ? "" : "s") con productos publicados.</p>
                        </div>
                        <div class="catalog-editor-section-actions">
                            <button type="button" class="canvas-action" data-create-category><i class="fa fa-tag"></i>Nueva categoría</button>
                            @if (Model.AvailableProducts.Any())
                            {
                                <button type="button" class="web-save" data-open-product-modal><i class="fa fa-plus"></i>Sumar producto</button>
                            }
                        </div>
                    </div>
                    @if (!allProducts.Any())
                    {
                        <div class="site-empty">Todavía no sumaste productos. Usá “Sumar producto” para incorporarlos al catálogo web.</div>
                    }
                    else
                    {
                        <div class="catalog-product-search" data-catalog-product-search>
                            <label class="catalog-product-search-field">
                                <i class="fa fa-search" aria-hidden="true"></i>
                                <input type="search"
                                       data-catalog-product-query
                                       placeholder="Buscar producto por nombre, categoría o unidad…"
                                       autocomplete="off"
                                       aria-label="Buscar productos del catálogo" />
                                <button type="button" class="catalog-product-search-clear" data-catalog-product-clear hidden title="Limpiar búsqueda" aria-label="Limpiar búsqueda">
                                    <i class="fa fa-times"></i>
                                </button>
                            </label>
                            <span class="catalog-product-search-count" data-catalog-product-count></span>
                        </div>
                        <div class="catalog-grid" data-catalog-product-grid>
                        @foreach (var product in allProducts)
                        {
                            <form asp-action="SaveProduct" method="post" enctype="multipart/form-data"
                                  class="catalog-card @(product.Published ? "" : "is-hidden-product")"
                                  id="product-editor-@product.ProductId"
                                  data-catalog-card
                                  data-search="@($"{product.Name} {product.Category} {product.Unit}")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductId" value="@product.ProductId" />

                                <div class="catalog-photos" data-image-picker data-existing="@product.Images.Count">
                                    @foreach (var image in product.Images)
                                    {
                                        <label class="catalog-photo is-saved" title="@image.OriginalFileName">
                                            <img src="@image.PreviewUrl" alt="" />
                                            <span class="catalog-photo-remove" title="Quitar foto">
                                                <input type="checkbox" name="RemoveImages" value="@image.FileName" />
                                                <i class="fa fa-times"></i>
                                            </span>
                                        </label>
                                    }
                                    <div class="catalog-photos-pending" data-pending-previews></div>
                                    <label class="catalog-photo is-add" title="Agregar fotos (hasta 4)" data-add-slot @if (product.Images.Count >= 4) { <text>hidden</text> }>
                                        <i class="fa fa-camera"></i>
                                        <span class="catalog-photo-add-label">+</span>
                                        <input name="ImageFiles" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple />
                                    </label>
                                </div>

                                <div class="catalog-body">
                                    <header class="catalog-head">
                                        <div class="catalog-name">@product.Name</div>
                                        <div class="catalog-meta">
                                            <span class="catalog-chip-unit">@product.Unit</span>
                                            Precio interno $ @product.DefaultPrice.ToString("N2")
                                        </div>
                                    </header>

                                    <section class="catalog-section">
                                        <h4 class="catalog-section-title">Precios</h4>
                                        <div class="catalog-fields">
                                            <label class="field">
                                                <span class="field-label">Precio en la web</span>
                                                <span class="field-input has-prefix">
                                                    <i class="field-prefix">$</i>
                                                    <input name="PublicPrice" type="number" step="0.01" min="0" value="@product.PublicPrice" placeholder="@product.DefaultPrice.ToString("0.00")" />
                                                </span>
                                                <span class="field-hint">Vacío usa el precio interno</span>
                                            </label>
                                            <label class="field">
                                                <span class="field-label">Precio tachado</span>
                                                <span class="field-input has-prefix">
                                                    <i class="field-prefix">$</i>
                                                    <input name="ListPrice" type="number" step="0.01" min="0" value="@product.ListPrice" placeholder="Opcional" />
                                                </span>
                                                <span class="field-hint">Precio de lista anterior</span>
                                            </label>
                                        </div>
                                    </section>

                                    <section class="catalog-section">
                                        <h4 class="catalog-section-title">Oferta y orden</h4>
                                        <div class="catalog-fields">
                                            <label class="field">
                                                <span class="field-label">Descuento</span>
                                                <span class="field-input has-suffix">
                                                    <input name="DiscountPercent" type="number" step="0.01" min="0" max="100" value="@product.DiscountPercent" placeholder="35" />
                                                    <i class="field-suffix">%</i>
                                                </span>
                                            </label>
                                            <label class="field">
                                                <span class="field-label">Posición</span>
                                                <span class="field-input">
                                                    <input name="SortOrder" type="number" min="0" value="@product.SortOrder" />
                                                </span>
                                                <span class="field-hint">El menor aparece primero</span>
                                            </label>
                                        </div>
                                        <label class="field mt-2">
                                            <span class="field-label">Etiqueta de oferta</span>
                                            <span class="field-input">
                                                <input name="OfferLabel" type="text" maxlength="40" value="@product.OfferLabel" placeholder="Ej: 35% OFF" />
                                            </span>
                                            <span class="field-hint">Se muestra sobre la foto en la web</span>
                                        </label>
                                    </section>

                                    <section class="catalog-section">
                                        <h4 class="catalog-section-title">Descripción en la web</h4>
                                        <label class="field">
                                            <span class="field-label">Texto público</span>
                                            <span class="field-input">
                                                <textarea name="PublicDescription" rows="3" maxlength="2000" placeholder="@product.Name">@product.PublicDescription</textarea>
                                            </span>
                                            <span class="field-hint">Si lo dejás vacío se usa el nombre del producto interno</span>
                                        </label>
                                    </section>

                                    <section class="catalog-section">
                                        <h4 class="catalog-section-title">Categoría</h4>
                                        <label class="field">
                                            <span class="field-input is-select">
                                                <i class="fa fa-tag"></i>
                                                <select name="CategoryId">
                                                    <option value="">Sin categoría</option>
                                                    @foreach (var category in Model.Categories)
                                                    {
                                                        <option value="@category.Id" selected="@(product.CategoryId == category.Id ? "selected" : null)">@category.Name</option>
                                                    }
                                                </select>
                                            </span>
                                        </label>
                                    </section>

                                    <section class="catalog-section">
                                        <h4 class="catalog-section-title">Visibilidad</h4>
                                        <div class="toggle-chips">
                                            <label class="toggle-chip is-visible">
                                                <input type="checkbox" name="Published" value="true" checked="@(product.Published ? "checked" : null)" />
                                                <input type="hidden" name="Published" value="false" />
                                                <i class="fa fa-eye"></i>
                                                <span>Visible</span>
                                            </label>
                                            <label class="toggle-chip is-featured">
                                                <input type="checkbox" name="Featured" value="true" checked="@(product.Featured ? "checked" : null)" />
                                                <input type="hidden" name="Featured" value="false" />
                                                <i class="fa fa-star"></i>
                                                <span>Destacado</span>
                                            </label>
                                            <label class="toggle-chip is-offer">
                                                <input type="checkbox" name="IsOnOffer" value="true" checked="@(product.IsOnOffer ? "checked" : null)" />
                                                <input type="hidden" name="IsOnOffer" value="false" />
                                                <i class="fa fa-bolt"></i>
                                                <span>Oferta</span>
                                            </label>
                                        </div>
                                        <p class="catalog-section-hint">
                                            Visible lo publica en el catálogo · Destacado lo marca en filtros del catálogo · Oferta lo muestra en Inicio y con etiqueta.
                                        </p>
                                    </section>

                                    <details class="catalog-more" @(string.IsNullOrWhiteSpace(product.Model3dUrl) ? null : "open")>
                                        <summary><i class="fa fa-cube"></i>Modelo 3D <span>opcional · archivo .glb</span></summary>
                                        <div class="model3d-editor mt-2">
                                            @if (!string.IsNullOrWhiteSpace(product.Model3dUrl))
                                            {
                                                <div class="model3d-current">
                                                    <i class="fa fa-cube"></i>
                                                    <div>
                                                        <strong>Archivo cargado</strong>
                                                        <span>@(product.Model3dFileName ?? product.Model3dUrl)</span>
                                                    </div>
                                                    <label class="model3d-remove">
                                                        <input type="checkbox" name="RemoveModel3d" value="true" />
                                                        Quitar
                                                    </label>
                                                </div>
                                                @if (product.HasLocalModel3d)
                                                {
                                                    <div class="model3d-preview">
                                                        <model-viewer src="@product.Model3dUrl" camera-controls auto-rotate shadow-intensity="1" alt="Vista previa 3D de @product.Name"></model-viewer>
                                                    </div>
                                                }
                                            }
                                            <label class="field">
                                                <span class="field-label">Subir archivo .glb</span>
                                                <span class="field-input">
                                                    <input name="Model3dFile" type="file" accept=".glb,model/gltf-binary" data-model3d-input />
                                                </span>
                                                <span class="field-hint">Hasta 25 MB. Podés rotarlo y revisarlo antes de guardar.</span>
                                            </label>
                                            <div class="model3d-preview is-pending" data-model3d-pending hidden></div>
                                        </div>
                                    </details>

                                    <div class="catalog-card-actions">
                                        <button class="web-save" type="submit"><i class="fa fa-check"></i>Guardar cambios</button>
                                        <button class="catalog-delete" type="submit" formaction="@Url.Action("DeleteProduct")" formmethod="post"
                                                onclick="return confirm('¿Quitar @product.Name del catálogo web?');" title="Quitar del catálogo">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        }
                        </div>
                    }
                </section>
            </div>

            <div class="site-footer">
                <div class="site-footer-grid">
                    <div>
                        <img src="~/Imagenes/logo-color.png" alt="Logo" />
                        <p class="live" contenteditable="true" data-edit-field="FooterDescription">@Model.FooterDescription</p>
                    </div>
                    <div>
                        <strong class="live" contenteditable="true" data-edit-field="FooterExploreTitle" data-single-line="true">@Model.FooterExploreTitle</strong>
                        <div class="site-footer-links">
                            <span class="live" contenteditable="true" data-edit-field="FooterCatalogLabel" data-single-line="true">@Model.FooterCatalogLabel</span>
                            <span class="live" contenteditable="true" data-edit-field="FooterAboutLabel" data-single-line="true">@Model.FooterAboutLabel</span>
                            <span class="live" contenteditable="true" data-edit-field="FooterContactLabel" data-single-line="true">@Model.FooterContactLabel</span>
                        </div>
                    </div>
                    <div>
                        <strong class="live" contenteditable="true" data-edit-field="FooterCommercialTitle" data-single-line="true">@Model.FooterCommercialTitle</strong>
                        <p class="live" contenteditable="true" data-edit-field="FooterCommercialText">@Model.FooterCommercialText</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ------------------------------ CONTACTO ------------------------------ *@
    <div class="web-tab-pane" id="web-tab-contact">
        <div class="site-canvas" data-preview>
            <div class="site-topbar"><span class="live" contenteditable="true" data-edit-field="TopbarPrimary">@Model.TopbarPrimary</span><span class="live" contenteditable="true" data-edit-field="TopbarSecondary">@Model.TopbarSecondary</span></div>
            <div class="site-header"><img src="~/Imagenes/logo-color.png" alt="Logo" /><div class="site-header-search"><i class="fa fa-search"></i><span class="live" contenteditable="true" data-edit-field="SearchPlaceholder">@Model.SearchPlaceholder</span><span class="live" contenteditable="true" data-edit-field="SearchButton">@Model.SearchButton</span></div><div class="site-nav"><button type="button" data-web-tab="home">@Model.NavHomeLabel</button><button type="button" data-web-tab="catalog">@Model.NavCatalogLabel</button><button type="button" data-web-tab="about">@Model.NavAboutLabel</button><button type="button" class="is-current" data-web-tab="contact">@Model.NavQuoteLabel</button><button type="button" class="site-cart" data-web-tab="cart"><span class="live" contenteditable="true" data-edit-field="CartLabel">@Model.CartLabel</span> (0)</button></div></div>
            <section class="contact-preview" data-section-theme style="background:@Model.ContactPageColor;color:@Model.ContactPageTextColor;">
                <partial name="_SectionTheme" model='("ContactPageColor", Model.ContactPageColor, "ContactPageTextColor", Model.ContactPageTextColor)' />
                <div class="contact-preview-copy theme-copy"><span class="home-editor-kicker">Contacto</span><h1 class="live" contenteditable="true" data-edit-field="ContactTitle">@Model.ContactTitle</h1><p class="live" contenteditable="true" data-edit-field="ContactLead">@Model.ContactLead</p><div class="contact-sent"><strong class="live" contenteditable="true" data-edit-field="ContactSentTitle">@Model.ContactSentTitle</strong><span class="live" contenteditable="true" data-edit-field="ContactSentOpenWhatsApp">@Model.ContactSentOpenWhatsApp</span></div></div>
                <div class="contact-preview-form">
                    <label class="live" contenteditable="true" data-edit-field="ContactLabelName">@Model.ContactLabelName</label><input disabled placeholder="Tu nombre" />
                    <label class="live" contenteditable="true" data-edit-field="ContactLabelCompany">@Model.ContactLabelCompany</label><input disabled placeholder="Empresa (opcional)" />
                    <label class="live" contenteditable="true" data-edit-field="ContactLabelPhone">@Model.ContactLabelPhone</label><input disabled placeholder="11 1234 5678" />
                    <label class="live" contenteditable="true" data-edit-field="ContactLabelEmail">@Model.ContactLabelEmail</label><input disabled placeholder="nombre@empresa.com" />
                    <label class="live" contenteditable="true" data-edit-field="ContactLabelCustomerType">@Model.ContactLabelCustomerType</label><input disabled placeholder="Elegí una opción" />
                    <label class="live" contenteditable="true" data-edit-field="ContactLabelMessage">@Model.ContactLabelMessage</label><div class="contact-textarea live" contenteditable="true" data-edit-field="ContactMessagePlaceholder">@Model.ContactMessagePlaceholder</div>
                    <span class="site-btn live" contenteditable="true" data-edit-field="ContactSubmit">@Model.ContactSubmit</span>
                </div>
            </section>
        </div>
    </div>

    @* ------------------------------ CARRITO ------------------------------ *@
    <div class="web-tab-pane" id="web-tab-cart">
        <div class="site-canvas" data-preview>
            <div class="site-topbar"><span class="live" contenteditable="true" data-edit-field="TopbarPrimary">@Model.TopbarPrimary</span><span class="live" contenteditable="true" data-edit-field="TopbarSecondary">@Model.TopbarSecondary</span></div>
            <div class="site-header"><img src="~/Imagenes/logo-color.png" alt="Logo" /><div class="site-header-search"><i class="fa fa-search"></i><span class="live" contenteditable="true" data-edit-field="SearchPlaceholder">@Model.SearchPlaceholder</span><span class="live" contenteditable="true" data-edit-field="SearchButton">@Model.SearchButton</span></div><div class="site-nav"><button type="button" data-web-tab="home">@Model.NavHomeLabel</button><button type="button" data-web-tab="catalog">@Model.NavCatalogLabel</button><button type="button" data-web-tab="about">@Model.NavAboutLabel</button><button type="button" data-web-tab="contact">@Model.NavQuoteLabel</button><button type="button" class="site-cart is-current" data-web-tab="cart"><span class="live" contenteditable="true" data-edit-field="CartLabel">@Model.CartLabel</span> (0)</button></div></div>
            <section class="cart-preview" data-section-theme style="background:@Model.CartPageColor;color:@Model.CartPageTextColor;">
                <partial name="_SectionTheme" model='("CartPageColor", Model.CartPageColor, "CartPageTextColor", Model.CartPageTextColor)' />
                <div class="cart-preview-head theme-copy"><span class="home-editor-kicker live" contenteditable="true" data-edit-field="CartKicker">@Model.CartKicker</span><h1 class="live" contenteditable="true" data-edit-field="CartTitle">@Model.CartTitle</h1><p class="live" contenteditable="true" data-edit-field="CartLead">@Model.CartLead</p><button type="button" class="site-text-link live" data-web-tab="catalog" contenteditable="true" data-edit-field="CartContinueShopping">@Model.CartContinueShopping</button></div>
                <div class="cart-preview-grid"><div class="cart-empty"><i class="fa fa-shopping-cart"></i><h2 class="live" contenteditable="true" data-edit-field="CartEmptyTitle">@Model.CartEmptyTitle</h2><p class="live" contenteditable="true" data-edit-field="CartEmptyText">@Model.CartEmptyText</p><button type="button" class="site-btn live" data-web-tab="catalog" contenteditable="true" data-edit-field="CartEmptyCta">@Model.CartEmptyCta</button></div><aside class="cart-summary"><h2 class="live" contenteditable="true" data-edit-field="CartSummaryTitle">@Model.CartSummaryTitle</h2><span class="cart-badge live" contenteditable="true" data-edit-field="CartSummaryBadge">@Model.CartSummaryBadge</span><p class="live" contenteditable="true" data-edit-field="CartSummaryNote">@Model.CartSummaryNote</p><span class="site-btn live" contenteditable="true" data-edit-field="CartCheckoutCta">@Model.CartCheckoutCta</span><div class="home-editor-lines live" contenteditable="true" data-edit-field="CartSafeItems">@Model.CartSafeItems</div></aside></div>
                <div class="checkout-preview"><h2 class="live" contenteditable="true" data-edit-field="CheckoutTitle">@Model.CheckoutTitle</h2><p class="live" contenteditable="true" data-edit-field="CheckoutLead">@Model.CheckoutLead</p><span class="site-btn live" contenteditable="true" data-edit-field="CheckoutSubmit">@Model.CheckoutSubmit</span><strong class="live" contenteditable="true" data-edit-field="CheckoutSentTitle">@Model.CheckoutSentTitle</strong><p class="live" contenteditable="true" data-edit-field="CheckoutSentLead">@Model.CheckoutSentLead</p><span class="live" contenteditable="true" data-edit-field="CheckoutSentOpenWhatsApp">@Model.CheckoutSentOpenWhatsApp</span><span class="live" contenteditable="true" data-edit-field="CheckoutSentContinue">@Model.CheckoutSentContinue</span></div>
            </section>
        </div>
    </div>

    <div class="web-modal-backdrop" id="productModal" hidden>
        <section class="web-modal web-modal-product" role="dialog" aria-modal="true" aria-labelledby="productModalTitle">
            <button type="button" class="web-modal-close" data-close-product-modal aria-label="Cerrar"><i class="fa fa-times"></i></button>
            <div class="web-modal-icon"><i class="fa fa-cube"></i></div>
            <h2 id="productModalTitle">Sumar producto al catálogo</h2>
            <p>Definí cómo se va a mostrar antes de agregarlo a la web.</p>

            <form asp-action="AddProduct" method="post" enctype="multipart/form-data" class="product-modal-form">
                @Html.AntiForgeryToken()
                <div class="modal-field">
                    <label for="newProductId">Producto de Gestión</label>
                    <select id="newProductId" name="ProductId" class="form-select web-product-select" required>
                        <option value=""></option>
                        @foreach (var product in Model.AvailableProducts)
                        {
                            <option value="@product.ProductId" data-price="@product.DefaultPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                @product.Name — @product.Category · $ @product.DefaultPrice.ToString("N2")
                            </option>
                        }
                    </select>
                </div>

                <div class="product-modal-grid">
                    <div class="modal-field">
                        <label for="newProductPrice">Precio público</label>
                        <input id="newProductPrice" name="PublicPrice" class="form-control" type="number" step="0.01" min="0" placeholder="Se usa el precio interno" />
                    </div>
                    <div class="modal-field">
                        <label for="newProductListPrice">Precio lista</label>
                        <input id="newProductListPrice" name="ListPrice" class="form-control" type="number" step="0.01" min="0" placeholder="Opcional (tachado)" />
                    </div>
                </div>

                <div class="product-modal-grid">
                    <div class="modal-field">
                        <label for="newProductDiscount">Descuento %</label>
                        <input id="newProductDiscount" name="DiscountPercent" class="form-control" type="number" step="0.01" min="0" max="100" placeholder="35" />
                    </div>
                    <div class="modal-field">
                        <label for="newProductOfferLabel">Etiqueta oferta</label>
                        <input id="newProductOfferLabel" name="OfferLabel" class="form-control" maxlength="40" placeholder="35% OFF" />
                    </div>
                </div>

                <div class="product-modal-grid">
                    <div class="modal-field">
                        <label for="newProductOrder">Orden</label>
                        <input id="newProductOrder" name="SortOrder" class="form-control" type="number" min="0" value="0" />
                    </div>
                    <div class="modal-field">
                        <label for="newProductCategory">Categoría</label>
                        <select id="newProductCategory" name="CategoryId" class="form-select">
                            <option value="">Mantener categoría del producto</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="modal-field">
                    <label for="newProductDescription">Descripción en la web</label>
                    <textarea id="newProductDescription" name="PublicDescription" class="form-control" rows="3" maxlength="2000" placeholder="Texto que se muestra en la ficha pública"></textarea>
                </div>

                <div class="modal-field">
                    <label>Fotos <span class="modal-note">hasta 4 · se previsualizan al elegirlas</span></label>
                    <div class="catalog-photos is-modal" data-image-picker data-existing="0">
                        <div class="catalog-photos-pending" data-pending-previews></div>
                        <label class="catalog-photo is-add" title="Agregar fotos (hasta 4)" data-add-slot>
                            <i class="fa fa-camera"></i>
                            <span class="catalog-photo-add-label">+</span>
                            <input id="newProductImages" name="ImageFiles" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple />
                        </label>
                    </div>
                    <div class="image-file-status" data-new-product-images>JPG, PNG o WebP. Hasta 4 fotos.</div>
                </div>

                <div class="modal-field">
                    <label for="newProduct3dFile">Modelo 3D <span class="modal-note">opcional · archivo .glb</span></label>
                    <input id="newProduct3dFile" name="Model3dFile" class="form-control" type="file" accept=".glb,model/gltf-binary" data-model3d-input />
                    <div class="image-file-status">Subí un archivo .glb de hasta 25 MB y revisalo antes de agregar el producto.</div>
                    <div class="model3d-preview is-pending" data-model3d-pending hidden></div>
                </div>

                <label class="modal-switch">
                    <input type="checkbox" name="Featured" value="true" />
                    <input type="hidden" name="Featured" value="false" />
                    <span>Marcar como destacado en el catálogo</span>
                </label>
                <label class="modal-switch">
                    <input type="checkbox" name="IsOnOffer" value="true" />
                    <input type="hidden" name="IsOnOffer" value="false" />
                    <span>Marcar como oferta</span>
                </label>

                <button class="web-save w-100 mt-3" type="submit"><i class="fa fa-plus"></i>Agregar al catálogo</button>
            </form>
        </section>
    </div>

    <div class="web-modal-backdrop" id="bannerModal" hidden>
        <section class="web-modal web-modal-product" role="dialog" aria-modal="true" aria-labelledby="bannerModalTitle">
            <button type="button" class="web-modal-close" data-close-banner-modal aria-label="Cerrar"><i class="fa fa-times"></i></button>
            <div class="web-modal-icon"><i class="fa fa-picture-o"></i></div>
            <h2 id="bannerModalTitle">Nuevo banner</h2>
            <p id="bannerModalText">Se muestra en el carrusel de Inicio y/o Catálogo.</p>

            <form asp-action="SaveBanner" method="post" enctype="multipart/form-data" class="product-modal-form" id="bannerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="bannerId" value="" />

                <div class="modal-field">
                    <label for="bannerTitle">Título <small class="text-muted">(opcional)</small></label>
                    <input id="bannerTitle" name="Title" class="form-control" maxlength="160" placeholder="Opcional si la imagen ya dice todo" />
                </div>
                <div class="modal-field">
                    <label for="bannerSubtitle">Subtítulo</label>
                    <input id="bannerSubtitle" name="Subtitle" class="form-control" maxlength="280" />
                </div>
                <div class="product-modal-grid">
                    <div class="modal-field">
                        <label for="bannerLink">Link</label>
                        <input id="bannerLink" name="LinkUrl" class="form-control" placeholder="/Catalog o URL" />
                    </div>
                    <div class="modal-field">
                        <label for="bannerCta">Texto del botón</label>
                        <input id="bannerCta" name="CtaLabel" class="form-control" maxlength="80" placeholder="Ver ofertas" />
                    </div>
                </div>
                <div class="product-modal-grid">
                    <div class="modal-field">
                        <label for="bannerOrder">Orden</label>
                        <input id="bannerOrder" name="SortOrder" class="form-control" type="number" min="0" value="0" />
                    </div>
                    <div class="modal-field">
                        <label for="bannerImage">Imagen</label>
                        <input id="bannerImage" name="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    </div>
                </div>

                <div class="banner-modal-preview" data-banner-preview-box hidden>
                    <div class="banner-modal-preview-frame">
                        <img data-banner-preview-img alt="Vista previa del banner" />
                        <div class="banner-modal-preview-meta">
                            <strong data-banner-preview-title>Vista previa</strong>
                            <span data-banner-preview-name>Sin archivo</span>
                        </div>
                    </div>
                </div>

                <label class="modal-switch">
                    <input type="checkbox" name="Active" id="bannerActive" value="true" checked />
                    <input type="hidden" name="Active" value="false" />
                    <span>Activo</span>
                </label>
                <label class="modal-switch">
                    <input type="checkbox" name="ShowOnHome" id="bannerHome" value="true" checked />
                    <input type="hidden" name="ShowOnHome" value="false" />
                    <span>Mostrar en Inicio</span>
                </label>
                <label class="modal-switch">
                    <input type="checkbox" name="ShowOnCatalog" id="bannerCatalog" value="true" checked />
                    <input type="hidden" name="ShowOnCatalog" value="false" />
                    <span>Mostrar en Catálogo</span>
                </label>
                <button class="web-save w-100 mt-3" type="submit"><i class="fa fa-save"></i>Guardar banner</button>
            </form>
        </section>
    </div>

    <div class="web-modal-backdrop" id="categoryModal" hidden>
        <section class="web-modal" role="dialog" aria-modal="true" aria-labelledby="categoryModalTitle">
            <button type="button" class="web-modal-close" data-close-category-modal aria-label="Cerrar"><i class="fa fa-times"></i></button>
            <div class="web-modal-icon"><i class="fa fa-tag"></i></div>
            <h2 id="categoryModalTitle">Nueva categoría</h2>
            <p id="categoryModalText">Creala y después asignala a los productos que correspondan.</p>

            <form id="categoryCreateForm" asp-action="AddCategory" method="post">
                @Html.AntiForgeryToken()
                <label for="categoryCreateName">Nombre</label>
                <input id="categoryCreateName" name="CategoryName" class="form-control" maxlength="80" autocomplete="off" required />
                <button class="web-save w-100 mt-3" type="submit"><i class="fa fa-plus"></i>Crear categoría</button>
            </form>

            <form id="categoryEditForm" asp-action="UpdateCategory" method="post" hidden>
                @Html.AntiForgeryToken()
                <input id="categoryEditId" name="CategoryId" type="hidden" />
                <label for="categoryEditName">Nombre</label>
                <input id="categoryEditName" name="CategoryName" class="form-control" maxlength="80" autocomplete="off" required />
                <button class="web-save w-100 mt-3" type="submit"><i class="fa fa-check"></i>Guardar categoría</button>
            </form>
        </section>
    </div>

    <div class="web-publish-dock" id="webPublishDock" hidden aria-live="polite">
        <div class="web-publish-dock-card">
            <div class="web-publish-dock-meta">
                <span class="web-publish-dock-icon" data-publish-icon><i class="fa fa-cloud-upload"></i></span>
                <div>
                    <strong data-publish-title>Publicando en la web…</strong>
                    <span data-publish-subtitle>Sincronizando catálogo, imágenes y textos</span>
                </div>
                <span class="web-publish-pct" data-publish-pct>0%</span>
            </div>
            <div class="web-publish-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-publish-track>
                <div class="web-publish-fill" id="webPublishFill"></div>
                <div class="web-publish-shine"></div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script type="module" src="https://unpkg.com/@@google/model-viewer/dist/model-viewer.min.js"></script>
    <script src="~/js/WebManagement.js" asp-append-version="true"></script>
}
