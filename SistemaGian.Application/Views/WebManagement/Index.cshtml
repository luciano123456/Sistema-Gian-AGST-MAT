@model SistemaGian.Application.Models.WebManagement.WebManagementViewModel
@using SistemaGian.Application.Models.WebManagement
@{
    ViewData["Title"] = "Web AGS MAT";

    var allProducts = Model.Products.OrderBy(p => p.SortOrder).ThenBy(p => p.Name).ToList();
    var visibleProducts = allProducts.Where(p => p.Published).ToList();
    // Misma regla que la web pública: el carrusel de catálogo muestra productos comunes
    // (ni destacados ni ofertas).
    var homeProducts = visibleProducts
        .Where(p => !p.Featured && !p.IsOnOffer)
        .Take(8)
        .ToList();
    if (homeProducts.Count == 0)
        homeProducts = visibleProducts.Take(8).ToList();
    var offerProducts = visibleProducts.Where(p => p.IsOnOffer).Take(8).ToList();
    // En el editor mostramos todas las categorías (también las nuevas sin productos).
    // En la web pública solo se publican las que tengan productos visibles.
    var visibleCategories = Model.Categories.ToList();
    var publishedCategoryCount = Model.Categories.Count(c => c.PublishedCount > 0);
    var flashOk = TempData["WebMessage"] as string;
    var flashError = TempData["WebError"] as string;
    var aboutChecklist = (Model.AboutChecklist ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var aboutPolicyPoints = (Model.AboutPolicyPoints ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var publishedProductCount = visibleProducts.Count;
}

@section Estilos {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/WebManagement.css" asp-append-version="true" />
}

<main class="web-admin container-fluid" data-edit-product="@Model.AutoEditProductId" data-preferred-tab="@TempData["WebTab"]">
    <section class="web-hero">
        <div>
            <div class="web-eyebrow">Editor de la web</div>
            <h1>Web AGS MAT</h1>
            <p>Tocá el lápiz de cada texto para editarlo. Guardá y después publicá para verlo en la web.</p>
        </div>
        <div class="web-hero-actions">
            @if (Model.SyncConfigured)
            {
                <span class="web-chip is-ok"><i class="fa fa-plug"></i>Conectada</span>
            }
            else
            {
                <span class="web-chip is-warn"><i class="fa fa-plug"></i>Sin conexión</span>
            }
            <form asp-action="Publish" method="post" data-publish-form>
                @Html.AntiForgeryToken()
                <button class="web-publish" type="submit" data-publish-button>
                    <i class="fa fa-cloud-upload"></i><span data-publish-label>Publicar en la web</span>
                </button>
            </form>
        </div>
    </section>

    @if (!Model.SyncConfigured)
    {
        <div class="alert alert-warning mt-3 mb-0">
            <i class="fa fa-plug me-2"></i>
            Falta el secreto compartido o la URL de la Web. Configurá <code>WebIntegration:SyncSecret</code> y <code>WebIntegration:PublicSiteSyncUrl</code>.
        </div>
    }

    <script type="application/json" id="webFlashMessages">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { ok = flashOk, error = flashError }))</script>

